# 部署前替换，真实值仅写入 .env（已忽略）
DATABASE_URL=postgresql+psycopg://fishingnet:CHANGE_ME@127.0.0.1:55432/fishingnet
APP_HOST=127.0.0.1
APP_PORT=8000
WORKSPACE_TIMEZONE=Asia/Shanghai
SETUP_TOKEN=GENERATE_RANDOM_ONE_TIME_TOKEN
MASTER_KEY=GENERATE_SECRET_KEY
AI_MODE=mock
CLOUD_ENABLED=false
DAILY_BUDGET=0
MONTHLY_BUDGET=0
# B站采集最小请求间隔（秒，建议 >=1.5）
FISHINGNET_BILIBILI_MIN_INTERVAL=1.5
# worker 内关键词来源调度；0 关闭自动调度（手动“立即运行”仍可用）
FISHINGNET_SCHEDULER=1
FISHINGNET_SCHEDULER_TICK=30
# 发现候选明细保留天数（1–3650）；运行账本与计数不会删除
FISHINGNET_DISCOVERY_ITEM_RETENTION_DAYS=30
